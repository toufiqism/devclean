# Cache subdirectories inside a profile. Everything not listed here is left alone.
PROFILE_CACHES = [
    "Service Worker/CacheStorage", "Service Worker/ScriptCache",
    "GPUCache", "DawnWebGPUCache", "DawnGraphiteCache", "GrShaderCache",
    "Shared Dictionary", "Code Cache", "Cache", "Media Cache",
    "Application Cache", "ShaderCache",
]

TOP_CACHES = [
    "extensions_crx_cache", "component_crx_cache", "BrowserMetrics",
    "OptGuideOnDeviceClassifierModel", "optimization_guide_model_store",
    "WasmTtsEngine", "ShaderCache", "GrShaderCache", "OnDeviceHeadSuggestModel",
    "SwReporter", "CertificateRevocation",
]

# Storage areas that may accumulate stranded large files.
STORAGE_AREAS = ["File System", "IndexedDB", "blob_storage"]


def discover_browsers() -> list[Target]:
    g = "Browser"
    out: list[Target] = []

    for pretty, (root, procs) in chromium_browsers().items():
        if not root.is_dir():
            continue
        block = f"quit {pretty} first" if proc_running(procs) else ""

        cache_paths, profiles = [], []
        for d in listdir(root):
            if d.is_dir() and (d.name == "Default" or d.name.startswith("Profile ")):
                profiles.append(d)
                for sub in PROFILE_CACHES:
                    p = d / sub
                    if p.exists():
                        cache_paths.append(p)
        for sub in TOP_CACHES:
            p = root / sub
            if p.exists():
                cache_paths.append(p)

        if cache_paths:
            out.append(Target(f"br_{pretty}", g, f"{pretty} caches",
                              f"{len(profiles)} profile(s). Passwords, bookmarks, "
                              f"history, extensions and IndexedDB untouched",
                              SAFE, cache_paths, blocked=block))

        # Stranded large files inside browser storage -> quarantine, never delete.
        for prof in profiles:
            for area in STORAGE_AREAS:
                a = prof / area
                if not a.is_dir():
                    continue
                for f in _big_files(a, 200 * 1024 * 1024):
                    kind = sniff(f)
                    t = Target(f"q_{abs(hash(str(f)))}", g,
                               f"Stranded file in {pretty} {area}",
                               f"{kind} - moved out, not deleted",
                               MOVE, [f], blocked=block)
                    try:
                        t.size = f.stat().st_size
                    except OSError:
                        continue
                    t.runner = _quarantine(f, kind)
                    out.append(t)

    # Chromium HTTP caches live outside the profile on macOS and Linux.
    if IS_MAC:
        http = {"Chrome": HOME / "Library" / "Caches" / "Google" / "Chrome",
                "Brave": HOME / "Library" / "Caches" / "BraveSoftware",
                "Edge": HOME / "Library" / "Caches" / "Microsoft Edge"}
    elif IS_LINUX:
        http = {"Chrome": XDG_CACHE / "google-chrome",
                "Chromium": XDG_CACHE / "chromium",
                "Brave": XDG_CACHE / "BraveSoftware",
                "Edge": XDG_CACHE / "microsoft-edge"}
    else:
        http = {}
    for pretty, p in http.items():
        if p.is_dir():
            out.append(Target(f"brc_{pretty}", g, f"{pretty} HTTP cache",
                              "Re-fetched as you browse", SAFE, [p]))

    # Firefox keeps its cache outside the profile on every platform.
    if IS_MAC:
        ff = HOME / "Library" / "Caches" / "Firefox"
    elif IS_WIN:
        ff = LOCALAPPDATA / "Mozilla" / "Firefox" / "Profiles"
    else:
        ff = XDG_CACHE / "mozilla" / "firefox"
    if ff.is_dir():
        procs = ["firefox.exe"] if IS_WIN else ["firefox"]
        out.append(Target("br_ff", g, "Firefox cache", "Re-fetched as you browse",
                          SAFE, [ff],
                          blocked="quit Firefox first" if proc_running(procs) else ""))
    return out


def _big_files(root: Path, min_size: int, max_depth: int = 5) -> list[Path]:
    found, stack = [], [(root, 0)]
    while stack:
        d, depth = stack.pop()
        if depth > max_depth:
            continue
        try:
            with os.scandir(d) as it:
                for entry in it:
                    try:
                        if entry.is_dir(follow_symlinks=False):
                            stack.append((Path(entry.path), depth + 1))
                        elif (entry.is_file(follow_symlinks=False)
                              and entry.stat(follow_symlinks=False).st_size > min_size):
                            found.append(Path(entry.path))
                    except OSError:
                        continue
        except OSError:
            continue
    return found


def _quarantine(src: Path, kind: str):
    def go() -> str:
        QUARANTINE_DIR.mkdir(parents=True, exist_ok=True)
        ext = {"Matroska/WebM video": ".mkv", "MP4/MOV video": ".mp4",
               "ZIP archive": ".zip", "PDF document": ".pdf"}.get(kind, ".bin")
        stamp = time.strftime("%Y%m%d", time.localtime(src.stat().st_mtime))
        dest = QUARANTINE_DIR / f"{src.parent.parent.name}-{stamp}-{src.name}{ext}"
        n = 1
        while dest.exists():
            dest = dest.with_name(f"{dest.stem}-{n}{ext}")
            n += 1
        shutil.move(str(src), str(dest))
        return f"moved to {dest}"
    return go


