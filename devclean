# --------------------------------------------------------------------------
# safety boundaries
# --------------------------------------------------------------------------

# Absolute no-go zones. Nothing under these is ever removed.
DENY = [HOME / n for n in (
    "Documents", "Desktop", "Pictures", "Music", "Movies", "Videos",
    "Downloads", "Development", "Projects", "src", "Dropbox", "OneDrive",
    ".ssh", ".gnupg", ".aws", ".kube", ".password-store",
)]
DENY.append(XDG_CONFIG / "gcloud")

if IS_MAC:
    DENY += [
        HOME / "Library" / "Keychains",
        HOME / "Library" / "Mobile Documents",
        HOME / "Library" / "Messages",
        HOME / "Library" / "Mail",
        HOME / "Library" / "Photos",
        HOME / "Library" / "Application Support" / "MobileSync",
    ]
elif IS_WIN:
    DENY += [
        LOCALAPPDATA / "Microsoft" / "Credentials",
        APPDATA / "Microsoft" / "Crypto",
        APPDATA / "Microsoft" / "Protect",
    ]
else:
    DENY += [XDG_DATA / "keyrings", HOME / ".local" / "share" / "keyrings"]

# Deletion is only ever allowed beneath one of these roots.
ALLOW_ROOTS = [HOME]
if IS_MAC:
    ALLOW_ROOTS.append(Path("/Library/Developer"))
for _root in (CACHE_ROOT, CONFIG_ROOT, XDG_DATA, LOCALAPPDATA, APPDATA):
    # Honour relocated cache/config roots that live outside the home directory.
    if _root and _root != HOME and HOME not in _root.parents:
        ALLOW_ROOTS.append(_root)
for _cache in STREMIO_CACHES:
    # Stremio offers to move its cache to another drive. Allow exactly that
    # cache directory, never the drive or folder it was moved into.
    if not any(r == _cache or r in _cache.parents for r in ALLOW_ROOTS):
        ALLOW_ROOTS.append(_cache)


# --------------------------------------------------------------------------
# helpers
