# execute
# --------------------------------------------------------------------------

def execute(targets: list[Target], dry: bool) -> None:
    sel = [t for t in targets if t.selected and not t.blocked]
    if not sel:
        print("Nothing selected.")
        return

    print(f"\n{C_BOLD}Plan{C_RESET}\n")
    for t in sel:
        verb = "MOVE" if t.risk == MOVE else "DELETE"
        col = RISK_COLOR.get(t.risk, "")
        print(f"  {col}{verb:<7}{C_RESET} {human(t.size).rjust(9)}  {t.label}")
    total = sum(t.size for t in sel)
    print(f"\n  reclaims about {C_BOLD}{C_GREEN}{human(total)}{C_RESET}\n")

    if dry:
        print(f"{C_DIM}--dry-run: nothing was changed.{C_RESET}")
        return

    try:
        if input(f"Type {C_BOLD}yes{C_RESET} to proceed: ").strip().lower() != "yes":
            print("Aborted. Nothing changed.")
            return
    except (EOFError, KeyboardInterrupt):
        print("\nAborted. Nothing changed.")
        return

    before, _ = disk_free()
    sudo_needed: list[str] = []
    print()

    for t in sel:
        try:
            if t.runner:
                msg = t.runner()
                print(f"  {C_GREEN}ok{C_RESET}  {t.label} - {msg}")
                continue

            removed, skipped = 0, 0
            for p in t.paths:
                if not guard(p):
                    skipped += 1
                    continue
                try:
                    if p.is_dir() and not p.is_symlink():
                        shutil.rmtree(p, ignore_errors=False)
                    else:
                        p.unlink()
                    removed += 1
                except PermissionError:
                    sudo_needed.append(str(p))
                    skipped += 1
                except OSError:
                    skipped += 1

            tail = f" ({skipped} skipped)" if skipped else ""
            state = C_GREEN + "ok" + C_RESET if removed else C_YELLOW + "--" + C_RESET
            print(f"  {state}  {t.label}{tail}")
        except Exception as e:
            print(f"  {C_RED}!!{C_RESET}  {t.label}: {e}")

    time.sleep(2)
    after, total_disk = disk_free()
    gained = after - before

    print(f"\n{C_BOLD}Done.{C_RESET}")
    print(f"  free: {human(before)} -> {C_BOLD}{human(after)}{C_RESET}  "
          f"({C_GREEN}+{human(max(0, gained))}{C_RESET})")
    if any(t.runner and "runtime" in t.key for t in sel):
        print(f"  {C_DIM}Simulator runtime deletion runs in the background; "
              f"more space frees up shortly.{C_RESET}")
    if QUARANTINE_DIR.exists():
        print(f"  {C_CYAN}Quarantined files -> {QUARANTINE_DIR}{C_RESET}")
    if sudo_needed:
        print(f"\n  {C_YELLOW}Needs elevated permission. Run this yourself:{C_RESET}")
        joined = " ".join(f'"{p}"' for p in sudo_needed[:6])
        print(f"    sudo rm -rf {joined}")


def main() -> int:
    ap = argparse.ArgumentParser(description="Interactive disk cleanup for macOS dev machines.")
    ap.add_argument("--dry-run", action="store_true", help="show the plan, change nothing")
    ap.add_argument("--safe-only", action="store_true", help="only offer SAFE items")
    args = ap.parse_args()

    if sys.platform != "darwin":
        print("devclean targets macOS.")
        return 1

    print(f"\n{C_BOLD}devclean{C_RESET}")
    targets = scan(args.safe_only)
    if not targets:
        print("Nothing worth cleaning.")
        return 0

    if not sys.stdin.isatty():
        for t in targets:
            print(f"{t.risk:<6} {human(t.size).rjust(9)}  {t.label}")
        return 0

    try:
        if choose(targets):
            execute(targets, args.dry_run)
        else:
            print("Cancelled. Nothing changed.")
    except KeyboardInterrupt:
        print("\nCancelled. Nothing changed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
