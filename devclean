def android_sdk() -> Path | None:
    for env in ("ANDROID_SDK_ROOT", "ANDROID_HOME"):
        val = os.environ.get(env)
        if val and Path(val).is_dir():
            return Path(val)
    if IS_MAC:
        cands = [HOME / "Library" / "Android" / "sdk"]
    elif IS_WIN:
        cands = [LOCALAPPDATA / "Android" / "Sdk"]
    else:
        cands = [HOME / "Android" / "Sdk", HOME / "Android" / "sdk"]
    return next((c for c in cands if c.is_dir()), None)


def gradle_home() -> Path:
    return _env_dir("GRADLE_USER_HOME", HOME / ".gradle")


def ide_config_roots() -> list[Path]:
    if IS_MAC:
        base = HOME / "Library" / "Application Support"
        return [base / "Google", base / "JetBrains"]
    if IS_WIN:
        return [APPDATA / "Google", APPDATA / "JetBrains"]
    return [XDG_CONFIG / "Google", XDG_CONFIG / "JetBrains"]


PROJECT_ROOTS = ("Development", "Projects", "src", "dev",
                 "AndroidStudioProjects", "StudioProjects", "IdeaProjects")

# Vendored SDK trees pin NDK versions for their own CI, not for your builds.
VENDOR_MARKERS = ("flutter-sdk", "flutter/dev", "flutter/examples",
                  "flutter/packages", "integration_tests", ".pub-cache",
                  "node_modules", "AppData")


def flutter_default_ndk() -> set[str]:
    """The NDK version `ndkVersion = flutter.ndkVersion` resolves to."""
    roots = []
    exe = shutil.which("flutter")
    if exe:
        roots.append(Path(exe).resolve().parent.parent)
    roots += [HOME / "Development" / "flutter-sdk" / "flutter",
              HOME / "flutter", HOME / "development" / "flutter",
              HOME / "fvm" / "default", LOCALAPPDATA / "flutter"]
    for r in roots:
        gu = (r / "packages" / "flutter_tools" / "lib" / "src" / "android"
              / "gradle_utils.dart")
        try:
            if gu.is_file():
                m = re.search(r"ndkVersion\s*=\s*['\"]([\d.]+)['\"]",
                              gu.read_text(errors="ignore"))
                if m:
                    return {m.group(1)}
        except OSError:
            continue
    return set()


def _gradle_files() -> list[Path]:
    """Locate project Gradle files without shelling out to find(1)."""
    roots = [HOME / n for n in PROJECT_ROOTS]
    roots = [r for r in roots if r.is_dir()]
    if not roots:
        return []

    prune = {"node_modules", "build", ".git", "Pods", ".dart_tool", ".gradle",
             "DerivedData", "Carthage", ".idea", "venv", ".venv"}
    wanted = {"build.gradle", "build.gradle.kts",
              "local.properties", "gradle.properties"}

    found: list[Path] = []
    for root in roots:
        stack = [(root, 0)]
        while stack and len(found) < 600:
            d, depth = stack.pop()
            if depth > 6:
                continue
            try:
                with os.scandir(d) as it:
                    for entry in it:
                        try:
                            if entry.is_dir(follow_symlinks=False):
                                if entry.name not in prune:
                                    stack.append((Path(entry.path), depth + 1))
                            elif entry.name in wanted:
                                found.append(Path(entry.path))
                        except OSError:
                            continue
            except OSError:
                continue
    return found


def pinned_ndk_versions() -> set[str]:
    """NDK versions your own projects actually build against.

    Two ways a project pins one, and both must be honoured:
      * an explicit `ndkVersion = "x.y.z"` in its Gradle files
      * `ndkVersion = flutter.ndkVersion`, which resolves to the constant in
        the Flutter SDK's gradle_utils.dart

    Vendored SDK trees are excluded. The Flutter SDK's own integration tests
    pin versions for Flutter's CI that no local app builds against, and
    counting those hides the versions that genuinely matter.
    """
    files = [f for f in _gradle_files()
             if not any(m in f.as_posix() for m in VENDOR_MARKERS)]
    if not files:
        return set()

    text = []
    for f in files:
        try:
            text.append(f.read_text(errors="ignore"))
        except OSError:
            continue
    blob = "\n".join(text)

    pins = set()
    for m in re.finditer(r"ndk(?:Version|\.dir)[^\n]{0,60}", blob):
        pins |= set(re.findall(r"\d+\.\d+\.\d{5,}", m.group(0)))
    if "flutter.ndkVersion" in blob:
        pins |= flutter_default_ndk()
    return pins


def discover_android() -> list[Target]:
    g = "Android"
    out: list[Target] = []
    sdk = android_sdk()

    if sdk:
        ndk_root = sdk / "ndk"
        if ndk_root.is_dir():
            versions = sorted([d for d in listdir(ndk_root) if d.is_dir()],
                              key=lambda d: version_key(d.name), reverse=True)
            installed = {d.name for d in versions}
            pinned = pinned_ndk_versions()
            keep = {d.name for d in versions[:2]} | (pinned & installed)
            for d in versions:
                if d.name not in keep:
                    out.append(Target(f"ndk_{d.name}", g, f"NDK {d.name}",
                                      "Re-installable via SDK Manager; not pinned by any project",
                                      REVIEW, [d]))
            kept_pins = sorted(pinned & installed)
            if kept_pins:
                out.append(Target("_ndk_note", g,
                                  "[kept: NDK pinned by your projects: "
                                  + ", ".join(kept_pins) + "]",
                                  "", SAFE, blocked="informational"))
            missing = sorted(pinned - installed)
            if missing:
                out.append(Target("_ndk_missing", g,
                                  "[MISSING: projects pin NDK "
                                  + ", ".join(missing) + " but it is not installed]",
                                  "", SAFE, blocked="informational"))

        for sub in ("system-images", "sources", "emulator/snapshots"):
            p = sdk / sub
            if p.is_dir() and has_content(p):
                risk = SAFE if "snapshots" in sub else REVIEW
                out.append(Target(f"sdk_{sub}", g, f"Android SDK {sub}",
                                  "Re-installable via SDK Manager", risk, [p]))

    gr = gradle_home()
    if (gr / "caches").is_dir():
        out.append(Target("gradle_caches", g, "Gradle caches",
                          "Dependencies re-download on next build (slow first build)",
                          REVIEW, [gr / "caches"]))
    for sub, why in (("daemon", "Daemon logs"),
                     ("native", "Regenerated automatically"),
                     ("kotlin-profile", "Profiling scratch data")):
        p = gr / sub
        if p.is_dir():
            out.append(Target(f"gradle_{sub}", g, f"Gradle {sub}", why, SAFE, [p]))

    # JetBrains / Android Studio configs - keep the one most recently touched.
    for base in ide_config_roots():
        if not base.is_dir():
            continue
        groups: dict[str, list[Path]] = {}
        for d in listdir(base):
            if not d.is_dir():
                continue
            m = re.match(r"([A-Za-z]+)[\d.]+$", d.name)
            if m:
                groups.setdefault(m.group(1), []).append(d)
        for fam, dirs in groups.items():
            if len(dirs) < 2:
                continue
            try:
                dirs.sort(key=lambda d: d.stat().st_mtime, reverse=True)
            except OSError:
                continue
            active = dirs[0]
            for d in dirs[1:]:
                out.append(Target(f"ide_{d.name}", g, f"Stale {fam} config: {d.name}",
                                  f"Superseded; active install is {active.name}",
                                  REVIEW, [d]))

    avd_root = _env_dir("ANDROID_AVD_HOME", HOME / ".android" / "avd")
    if avd_root.is_dir():
        snaps = [p for p in avd_root.glob("*/snapshots") if p.is_dir()]
        if snaps:
            out.append(Target("avd_snap", g, "Emulator snapshots",
                              "Cold-boot state; emulators still work without them",
                              SAFE, snaps))
    return out


