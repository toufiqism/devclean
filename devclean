def _env_dir(name: str, default: Path) -> Path:
    val = os.environ.get(name)
    return Path(val) if val else default


LOCALAPPDATA = _env_dir("LOCALAPPDATA", HOME / "AppData" / "Local")
APPDATA = _env_dir("APPDATA", HOME / "AppData" / "Roaming")
XDG_CACHE = _env_dir("XDG_CACHE_HOME", HOME / ".cache")
XDG_CONFIG = _env_dir("XDG_CONFIG_HOME", HOME / ".config")
XDG_DATA = _env_dir("XDG_DATA_HOME", HOME / ".local" / "share")

if IS_MAC:
    CACHE_ROOT = HOME / "Library" / "Caches"
    CONFIG_ROOT = HOME / "Library" / "Application Support"
    OS_NAME = "macOS"
elif IS_WIN:
    # Deliberately not LOCALAPPDATA: on Windows that directory holds real
    # application state alongside caches, so there is no safe generic sweep.
    CACHE_ROOT = None
    CONFIG_ROOT = APPDATA
    OS_NAME = "Windows"
else:
    CACHE_ROOT = XDG_CACHE
    CONFIG_ROOT = XDG_CONFIG
    OS_NAME = "Linux"


def quarantine_dir() -> Path:
    desktop = HOME / "Desktop"
    return (desktop if desktop.is_dir() else HOME) / "devclean-quarantine"


QUARANTINE_DIR = quarantine_dir()


def stremio_cache_dirs() -> list[Path]:
    """Every directory Stremio's streaming server keeps torrent pieces in.

    Mirrors server.js: settings live in an app directory, pieces in
    <cacheRoot>/stremio-cache. cacheRoot defaults to the app directory, except
    that newer servers default to %LOCALAPPDATA%\\Stremio on Windows. Moving the
    cache from Stremio's settings records the new root in server-settings.json,
    along with any old roots the server has not finished cleaning.
    """
    if IS_MAC:
        apps = [HOME / "Library" / "Application Support" / "stremio-server"]
        roots = list(apps)
    elif IS_WIN:
        apps = [APPDATA / "stremio" / "stremio-server"]
        roots = [LOCALAPPDATA / "Stremio"] + apps
    else:
        # The Flatpak build persists the same directory inside its sandbox.
        apps = [HOME / ".stremio-server",
                HOME / ".var" / "app" / "com.stremio.Stremio" / ".stremio-server"]
        roots = list(apps)

    for app in apps:
        try:
            settings = json.loads((app / "server-settings.json")
                                  .read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if not isinstance(settings, dict):
            continue
        old = settings.get("cacheRootsToClean")
        for r in [settings.get("cacheRoot")] + (old if isinstance(old, list) else []):
            if isinstance(r, str) and os.path.isabs(r):
                roots.append(Path(r))

    found: list[Path] = []
    for r in roots:
        try:
            c = (r / "stremio-cache").resolve()
        except OSError:
            continue
        if c.is_dir() and c not in found:
            found.append(c)
    return found


STREMIO_CACHES = stremio_cache_dirs()

SAFE, REVIEW, MOVE = "SAFE", "REVIEW", "MOVE"


