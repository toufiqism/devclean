RISK_COLOR = {SAFE: C_GREEN, REVIEW: C_YELLOW, MOVE: C_CYAN}

# Absolute no-go zones. Nothing under these is ever removed.
DENY = [
    HOME / "Documents",
    HOME / "Desktop",
    HOME / "Pictures",
    HOME / "Movies",
    HOME / "Music",
    HOME / "Downloads",
    HOME / "Development",
    HOME / "Projects",
    HOME / "src",
    HOME / ".ssh",
    HOME / ".gnupg",
    HOME / "Library" / "Keychains",
    HOME / "Library" / "Mobile Documents",
    HOME / "Library" / "Messages",
    HOME / "Library" / "Mail",
]

# Deletion is only ever allowed beneath one of these roots.
ALLOW_ROOTS = [HOME, Path("/Library/Developer")]


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------

def human(n: int) -> str:
    if n <= 0:
        return "0 B"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024.0
    return f"{n:.1f} TB"


def run(cmd: list[str], timeout: int = 120) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout
    except Exception:
        return ""


def du_bytes(paths) -> int:
    """Total on-disk size via du, which is far faster than walking in Python."""
    real = [str(p) for p in paths if Path(p).exists()]
    if not real:
        return 0
    total = 0
    for i in range(0, len(real), 150):
        out = run(["du", "-sk"] + real[i:i + 150], timeout=300)
        for line in out.splitlines():
            head = line.split("\t")[0].strip()
            if head.isdigit():
                total += int(head) * 1024
    return total


def listdir(p: Path) -> list[Path]:
    """iterdir() that yields [] instead of raising on protected dirs."""
    try:
        return list(p.iterdir())
    except OSError:
        return []


def has_content(p: Path) -> bool:
    return bool(listdir(p))


def guard(p: Path) -> bool:
    """True only if p is safe to delete."""
    try:
        p = Path(p).expanduser()
        if not p.is_absolute() or not p.exists():
            return False
        rp = p.resolve()
        if rp == HOME or rp == Path("/") or len(rp.parts) <= 2:
            return False
        for d in DENY:
            if rp == d or d in rp.parents:
                return False
        return any(r == rp or r in rp.parents for r in ALLOW_ROOTS)
    except OSError:
        return False


def disk_free() -> tuple[int, int]:
    st = os.statvfs("/System/Volumes/Data")
    return st.f_bavail * st.f_frsize, st.f_blocks * st.f_frsize


def version_key(s: str) -> tuple:
    return tuple(int(x) for x in re.findall(r"\d+", s)[:4]) or (0,)


# --------------------------------------------------------------------------
# target model
# --------------------------------------------------------------------------

@dataclass
class Target:
    key: str
    group: str
    label: str
    detail: str
    risk: str
    paths: list[Path] = field(default_factory=list)
    runner: object = None          # callable() -> str, for non-path actions
    size: int = 0
    note: str = ""
    selected: bool = False
    blocked: str = ""              # non-empty means it cannot run right now


