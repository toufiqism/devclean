@dataclass
class Target:
    key: str
    group: str
    label: str
    detail: str
    risk: str
    paths: list[Path] = field(default_factory=list)
    runner: object = None          # callable() -> str, for non-path actions
    size: int = 0
    note: str = ""
    selected: bool = False
    blocked: str = ""              # non-empty means it cannot run right now


# --------------------------------------------------------------------------
# discovery: Xcode and iOS simulators (macOS only)
# --------------------------------------------------------------------------

def discover_xcode() -> list[Target]:
    if not IS_MAC:
        return []

    g = "Xcode & Simulators"
    out: list[Target] = []
    dev = HOME / "Library" / "Developer"

    dd = dev / "Xcode" / "DerivedData"
    if dd.is_dir() and has_content(dd):
        out.append(Target("derived", g, "Xcode DerivedData",
                          "Build intermediates; rebuilt on next build",
                          SAFE, [dd]))

    ds = dev / "Xcode" / "iOS DeviceSupport"
    if ds.is_dir():
        kids = sorted(listdir(ds))
        if kids:
            out.append(Target("devsupport", g, "iOS DeviceSupport",
                              f"{len(kids)} device(s); re-created when you replug",
                              SAFE, kids))

    for name, risk, why in (
        ("Archives", REVIEW, "Shipped-build archives - needed to symbolicate crash reports"),
        ("Products", SAFE, "Build products"),
        ("CodingAssistant", REVIEW, "Xcode assistant data - may include chat history"),
    ):
        p = dev / "Xcode" / name
        if p.is_dir() and has_content(p):
            out.append(Target(f"xc_{name}", g, f"Xcode {name}", why, risk, [p]))

    tmp = dev / "CoreSimulator" / "Temp"
    if tmp.is_dir() and has_content(tmp):
        out.append(Target("simtemp", g, "Simulator temp files", "Scratch data", SAFE, [tmp]))

    return out


def discover_simulators() -> list[Target]:
    if not IS_MAC or not shutil.which("xcrun"):
        return []

    g = "Xcode & Simulators"
    out: list[Target] = []

    # Installed runtimes - keep the newest, offer the rest.
    raw = run(["xcrun", "simctl", "runtime", "list", "-j"], timeout=60)
    runtimes = []
    try:
        data = json.loads(raw) if raw.strip() else {}
        for uid, info in (data.items() if isinstance(data, dict) else []):
            if not isinstance(info, dict):
                continue
            runtimes.append({
                "id": uid,
                "version": str(info.get("version", "?")),
                "size": int(info.get("sizeBytes") or 0),
                "name": info.get("name") or f"iOS {info.get('version', '?')}",
            })
    except (json.JSONDecodeError, ValueError):
        pass

    if len(runtimes) > 1:
        runtimes.sort(key=lambda r: version_key(r["version"]), reverse=True)
        newest = runtimes[0]
        for r in runtimes[1:]:
            t = Target(f"rt_{r['id']}", g, f"Simulator runtime {r['name']}",
                       f"Re-downloadable in Xcode; keeping {newest['name']}",
                       REVIEW, runner=_runtime_deleter(r["id"]))
            t.size = r["size"]
            out.append(t)

    devs = run(["xcrun", "simctl", "list", "devices", "-j"], timeout=60)
    count = 0
    try:
        for _rt, lst in (json.loads(devs).get("devices", {}) or {}).items():
            count += len(lst)
    except (json.JSONDecodeError, ValueError, AttributeError):
        pass
    devdir = HOME / "Library" / "Developer" / "CoreSimulator" / "Devices"
    if count and devdir.is_dir():
        out.append(Target("simdevices", g, f"All {count} simulator devices",
                          "Xcode recreates defaults; wipes installed apps and their data",
                          REVIEW, runner=_devices_deleter(), paths=[devdir]))

    dyld = Path("/Library/Developer/CoreSimulator/Caches/dyld")
    if dyld.is_dir():
        t = Target("dyld", g, "Simulator dyld cache",
                   "Rebuilt on next simulator boot (first boot is slower)",
                   SAFE, [dyld])
        t.note = "needs sudo"
        out.append(t)

    return out


def _runtime_deleter(uid: str):
    def go() -> str:
        subprocess.run(["xcrun", "simctl", "runtime", "delete", uid],
                       capture_output=True, timeout=120)
        return "deletion queued (runs in background)"
    return go


def _devices_deleter():
    def go() -> str:
        subprocess.run(["xcrun", "simctl", "delete", "all"],
                       capture_output=True, timeout=300)
        return "deleted"
    return go


