def human(n: int) -> str:
    if n <= 0:
        return "0 B"
    val = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if val < 1024 or unit == "TB":
            return f"{val:.0f} {unit}" if unit in ("B", "KB") else f"{val:.1f} {unit}"
        val /= 1024.0
    return f"{val:.1f} TB"


def run(cmd: list[str], timeout: int = 120) -> str:
    try:
        kwargs = {}
        if IS_WIN:
            # Keep console windows from flashing up for each probe.
            kwargs["creationflags"] = 0x08000000  # CREATE_NO_WINDOW
        r = subprocess.run(cmd, capture_output=True, text=True,
                           timeout=timeout, **kwargs)
        return r.stdout or ""
    except Exception:
        return ""


HAVE_DU = IS_POSIX and shutil.which("du") is not None


def _walk_size(path: Path) -> int:
    """Portable fallback for du: iterative scandir, skipping what we can't read."""
    try:
        st = path.lstat()
    except OSError:
        return 0
    if not path.is_dir() or path.is_symlink():
        return st.st_size

    total, stack = 0, [str(path)]
    while stack:
        current = stack.pop()
        try:
            with os.scandir(current) as it:
                for entry in it:
                    try:
                        if entry.is_dir(follow_symlinks=False):
                            stack.append(entry.path)
                        elif entry.is_file(follow_symlinks=False):
                            total += entry.stat(follow_symlinks=False).st_size
                    except OSError:
                        continue
        except OSError:
            continue
    return total


def du_bytes(paths) -> int:
    """Total on-disk size. Uses du where present; walks the tree otherwise."""
    real = [p for p in paths if Path(p).exists()]
    if not real:
        return 0

    if HAVE_DU:
        total = 0
        strs = [str(p) for p in real]
        for i in range(0, len(strs), 150):
            out = run(["du", "-sk"] + strs[i:i + 150], timeout=300)
            for line in out.splitlines():
                head = line.split("\t")[0].strip()
                if head.isdigit():
                    total += int(head) * 1024
        if total:
            return total

    with ThreadPoolExecutor(max_workers=8) as ex:
        return sum(ex.map(lambda p: _walk_size(Path(p)), real))


def listdir(p: Path) -> list[Path]:
    """iterdir() that yields [] instead of raising on protected dirs."""
    try:
        return list(p.iterdir())
    except OSError:
        return []


def has_content(p: Path) -> bool:
    return bool(listdir(p))


def guard(p: Path) -> bool:
    """True only if p is safe to delete."""
    try:
        p = Path(p).expanduser()
        if not p.is_absolute() or not p.exists():
            return False
        rp = p.resolve()
        if rp == HOME or rp == rp.anchor or len(rp.parts) <= 2:
            return False
        for d in DENY:
            if rp == d or d in rp.parents:
                return False
        return any(r == rp or r in rp.parents for r in ALLOW_ROOTS)
    except OSError:
        return False


def disk_free() -> tuple[int, int]:
    """(free, total) for the volume the home directory lives on."""
    usage = shutil.disk_usage(str(HOME))
    return usage.free, usage.total


def version_key(s: str) -> tuple:
    return tuple(int(x) for x in re.findall(r"\d+", s)[:4]) or (0,)


# File signatures, so quarantined items can be described without shelling out
# to file(1) - which does not exist on Windows.
MAGIC = [
    (0, b"\x1a\x45\xdf\xa3", "Matroska/WebM video"),
    (4, b"ftyp", "MP4/MOV video"),
    (0, b"RIFF", "RIFF media (AVI/WAV)"),
    (0, b"\x89PNG", "PNG image"),
    (0, b"\xff\xd8\xff", "JPEG image"),
    (0, b"GIF8", "GIF image"),
    (0, b"PK\x03\x04", "ZIP archive"),
    (0, b"SQLite format 3", "SQLite database"),
    (0, b"%PDF", "PDF document"),
    (0, b"\x1f\x8b", "gzip archive"),
    (0, b"OggS", "Ogg media"),
    (0, b"fLaC", "FLAC audio"),
    (0, b"ID3", "MP3 audio"),
    (0, b"\x37\x7a\xbc\xaf", "7-Zip archive"),
]


def sniff(path: Path) -> str:
    try:
        with open(path, "rb") as fh:
            head = fh.read(64)
    except OSError:
        return "unreadable"
    for offset, sig, label in MAGIC:
        if head[offset:offset + len(sig)] == sig:
            return label
    return "binary data"


def proc_running(names: list[str]) -> bool:
    if IS_WIN:
        out = run(["tasklist", "/FO", "CSV", "/NH"], timeout=30).lower()
        return any(n.lower() in out for n in names)
    for n in names:
        if run(["pgrep", "-x", n], timeout=15).strip():
            return True
    return False


