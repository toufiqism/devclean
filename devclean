class Keyboard:
    def __enter__(self):
        self.fd = sys.stdin.fileno()
        self.old = termios.tcgetattr(self.fd)
        tty.setraw(self.fd)
        return self

    def __exit__(self, *a):
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)

    def key(self) -> str:
        ch = sys.stdin.read(1)
        if ch == "\x1b":
            nxt = sys.stdin.read(2)
            return {"[A": "up", "[B": "down", "[C": "right", "[D": "left"}.get(nxt, "esc")
        if ch in ("\r", "\n"):
            return "enter"
        if ch == "\x03":
            return "quit"
        return ch.lower()


def render(targets: list[Target], cursor: int, top: int, rows: int) -> None:
    free, total = disk_free()
    used = total - free
    pct = used / total * 100 if total else 0
    sel = [t for t in targets if t.selected and not t.blocked]
    gain = sum(t.size for t in sel)

    bar_w = 28
    filled = int(bar_w * pct / 100)
    bar = "█" * filled + "░" * (bar_w - filled)
    colr = C_RED if pct > 85 else (C_YELLOW if pct > 70 else C_GREEN)

    sys.stdout.write("\033[H\033[J")
    print(f"{C_BOLD}  devclean{C_RESET}  {C_DIM}interactive disk cleanup{C_RESET}\r")
    print(f"  {colr}{bar}{C_RESET} {human(used)} used / {human(total)}  "
          f"{C_BOLD}{human(free)} free{C_RESET} ({pct:.0f}%)\r")
    print(f"  selected: {C_BOLD}{len(sel)}{C_RESET} item(s)  "
          f"reclaims {C_GREEN}{C_BOLD}{human(gain)}{C_RESET}  "
          f"-> {human(free + gain)} free\r")
    print(f"  {C_DIM}{'-' * 74}{C_RESET}\r")

    group = None
    shown = targets[top:top + rows]
    for i, t in enumerate(shown, start=top):
        if t.group != group:
            group = t.group
            print(f"  {C_BOLD}{group}{C_RESET}\r")
        mark = "x" if t.selected and not t.blocked else " "
        col = RISK_COLOR.get(t.risk, "")
        cur = C_INV if i == cursor else ""
        size = human(t.size).rjust(9)

        if t.blocked == "informational":
            print(f"    {C_DIM}{t.label}{C_RESET}\r")
            continue
        tag = f"{col}{t.risk:<6}{C_RESET}"
        line = f"  {cur}[{mark}]{C_RESET} {size}  {tag} {t.label}"
        print(line + "\r")
        if i == cursor:
            note = t.blocked or t.detail
            style = C_RED if t.blocked else C_DIM
            print(f"          {style}{note}{C_RESET}\r")
            if t.note:
                print(f"          {C_YELLOW}({t.note}){C_RESET}\r")

    print(f"  {C_DIM}{'-' * 74}{C_RESET}\r")
    print(f"  {C_DIM}↑↓ move   space toggle   a all-safe   n none   "
          f"v invert   enter clean   q quit{C_RESET}\r")


def choose(targets: list[Target]) -> bool:
    live = [t for t in targets if t.blocked != "informational"]
    if not live:
        print("Nothing worth cleaning. Disk looks tidy.")
        return False

    cursor, top = 0, 0
    rows = max(8, (shutil.get_terminal_size((80, 30)).lines) - 14)

    with Keyboard() as kb:
        while True:
            visible = [i for i, t in enumerate(targets)]
            render(targets, cursor, top, rows)
            k = kb.key()

            if k in ("q", "quit", "esc"):
                sys.stdout.write("\033[H\033[J")
                return False
            if k == "up":
                cursor = max(0, cursor - 1)
                while cursor > 0 and targets[cursor].blocked == "informational":
                    cursor -= 1
            elif k == "down":
                cursor = min(len(targets) - 1, cursor + 1)
                while cursor < len(targets) - 1 and targets[cursor].blocked == "informational":
                    cursor += 1
            elif k == " ":
                t = targets[cursor]
                if not t.blocked:
                    t.selected = not t.selected
            elif k == "a":
                for t in targets:
                    if not t.blocked:
                        t.selected = t.risk == SAFE
            elif k == "n":
                for t in targets:
                    t.selected = False
            elif k == "v":
                for t in targets:
                    if not t.blocked and t.blocked != "informational":
                        t.selected = not t.selected
            elif k == "enter":
                sys.stdout.write("\033[H\033[J")
                return True

            if cursor < top:
                top = cursor
            elif cursor >= top + rows:
                top = cursor - rows + 1


