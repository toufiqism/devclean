def discover_caches() -> list[Target]:
    g = "Caches"
    out: list[Target] = []
    seen: set[Path] = set()

    for key, p, why in _cache_candidates():
        if p.is_dir() and has_content(p) and p not in seen:
            seen.add(p)
            risk = REVIEW if key in ("maven", "nuget", "pub") else SAFE
            out.append(Target(f"c_{key}", g, p.name, why, risk, [p]))

    # A generic sweep is only safe where the OS defines a real cache root.
    # Windows has none - LOCALAPPDATA mixes caches with application state.
    if CACHE_ROOT and CACHE_ROOT.is_dir():
        skip = {"vscode-ripgrep"} | {p.name for p in seen}
        skip |= {"Firefox", "mozilla", "google-chrome", "chromium",
                 "BraveSoftware", "Microsoft Edge", "microsoft-edge", "Google"}
        kids = [d for d in listdir(CACHE_ROOT)
                if d.is_dir() and d.name not in skip and d not in seen]
        if kids:
            label = "~/Library/Caches" if IS_MAC else "~/.cache"
            out.append(Target("cacheroot", g, f"{label} (app caches)",
                              f"{len(kids)} cache dir(s); apps rebuild them",
                              SAFE, kids))
    return out


