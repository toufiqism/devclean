class Keyboard:
    """Single-keypress reader. Raw mode on POSIX, msvcrt on Windows."""

    def __enter__(self):
        if IS_POSIX:
            self.fd = sys.stdin.fileno()
            self.old = termios.tcgetattr(self.fd)
            tty.setraw(self.fd)
        return self

    def __exit__(self, *a):
        if IS_POSIX:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)

    def key(self) -> str:
        if IS_WIN:
            ch = msvcrt.getwch()
            if ch in ("\x00", "\xe0"):        # extended key prefix
                code = msvcrt.getwch()
                return {"H": "up", "P": "down",
                        "M": "right", "K": "left"}.get(code, "esc")
            if ch in ("\r", "\n"):
                return "enter"
            if ch == "\x03":
                return "quit"
            if ch == "\x1b":
                return "esc"
            return ch.lower()

        ch = sys.stdin.read(1)
        if ch == "\x1b":
            nxt = sys.stdin.read(2)
            return {"[A": "up", "[B": "down",
                    "[C": "right", "[D": "left"}.get(nxt, "esc")
        if ch in ("\r", "\n"):
            return "enter"
        if ch == "\x03":
            return "quit"
        return ch.lower()


def _line(text: str) -> None:
    """Rows need an explicit CR on POSIX raw mode; Windows cooks it for us."""
    print(text + ("" if IS_WIN else "\r"))


def render(targets: list[Target], cursor: int, top: int, rows: int) -> None:
    free, total = disk_free()
    used = total - free
    pct = used / total * 100 if total else 0
    sel = [t for t in targets if t.selected and not t.blocked]
    gain = sum(t.size for t in sel)

    bar_w = 28
    filled = int(bar_w * pct / 100)
    bar = BAR_FULL * filled + BAR_EMPTY * (bar_w - filled)
    colr = C_RED if pct > 85 else (C_YELLOW if pct > 70 else C_GREEN)

    sys.stdout.write("\033[H\033[J" if ANSI else "\n" * 3)
    _line(f"{C_BOLD}  devclean{C_RESET}  {C_DIM}interactive disk cleanup "
          f"· {OS_NAME}{C_RESET}" if UNICODE else
          f"{C_BOLD}  devclean{C_RESET}  {C_DIM}interactive disk cleanup"
          f" - {OS_NAME}{C_RESET}")
    _line(f"  {colr}{bar}{C_RESET} {human(used)} used / {human(total)}  "
          f"{C_BOLD}{human(free)} free{C_RESET} ({pct:.0f}%)")
    _line(f"  selected: {C_BOLD}{len(sel)}{C_RESET} item(s)  "
          f"reclaims {C_GREEN}{C_BOLD}{human(gain)}{C_RESET}  "
          f"-> {human(free + gain)} free")
    _line(f"  {C_DIM}{'-' * 74}{C_RESET}")

    group = None
    for i, t in enumerate(targets[top:top + rows], start=top):
        if t.group != group:
            group = t.group
            _line(f"  {C_BOLD}{group}{C_RESET}")
        if t.blocked == "informational":
            _line(f"    {C_DIM}{t.label}{C_RESET}")
            continue
        mark = "x" if t.selected and not t.blocked else " "
        col = RISK_COLOR.get(t.risk, "")
        cur = C_INV if i == cursor else ""
        size = human(t.size).rjust(9)
        _line(f"  {cur}[{mark}]{C_RESET} {size}  {col}{t.risk:<6}{C_RESET} {t.label}")
        if i == cursor:
            note = t.blocked or t.detail
            style = C_RED if t.blocked else C_DIM
            _line(f"          {style}{note}{C_RESET}")
            if t.note:
                _line(f"          {C_YELLOW}({t.note}){C_RESET}")

    _line(f"  {C_DIM}{'-' * 74}{C_RESET}")
    _line(f"  {C_DIM}{KEYHINT}   space toggle   a all-safe   n none   "
          f"v invert   enter clean   q quit{C_RESET}")


def choose(targets: list[Target]) -> bool:
    if not [t for t in targets if t.blocked != "informational"]:
        print("Nothing worth cleaning. Disk looks tidy.")
        return False

    cursor, top = 0, 0
    rows = max(8, shutil.get_terminal_size((80, 30)).lines - 14)

    with Keyboard() as kb:
        while True:
            render(targets, cursor, top, rows)
            k = kb.key()

            if k in ("q", "quit", "esc"):
                if ANSI:
                    sys.stdout.write("\033[H\033[J")
                return False
            if k == "up":
                cursor = max(0, cursor - 1)
                while cursor > 0 and targets[cursor].blocked == "informational":
                    cursor -= 1
            elif k == "down":
                cursor = min(len(targets) - 1, cursor + 1)
                while (cursor < len(targets) - 1
                       and targets[cursor].blocked == "informational"):
                    cursor += 1
            elif k == " ":
                t = targets[cursor]
                if not t.blocked:
                    t.selected = not t.selected
            elif k == "a":
                for t in targets:
                    if not t.blocked:
                        t.selected = t.risk == SAFE
            elif k == "n":
                for t in targets:
                    t.selected = False
            elif k == "v":
                for t in targets:
                    if not t.blocked:
                        t.selected = not t.selected
            elif k == "enter":
                if ANSI:
                    sys.stdout.write("\033[H\033[J")
                return True

            if cursor < top:
                top = cursor
            elif cursor >= top + rows:
                top = cursor - rows + 1


# --------------------------------------------------------------------------
# execute
# --------------------------------------------------------------------------

def execute(targets: list[Target], dry: bool) -> None:
    sel = [t for t in targets if t.selected and not t.blocked]
    if not sel:
        print("Nothing selected.")
        return

    print(f"\n{C_BOLD}Plan{C_RESET}\n")
    for t in sel:
        verb = "MOVE" if t.risk == MOVE else "DELETE"
        col = RISK_COLOR.get(t.risk, "")
        print(f"  {col}{verb:<7}{C_RESET} {human(t.size).rjust(9)}  {t.label}")
    total = sum(t.size for t in sel)
    print(f"\n  reclaims about {C_BOLD}{C_GREEN}{human(total)}{C_RESET}\n")

    if dry:
        print(f"{C_DIM}--dry-run: nothing was changed.{C_RESET}")
        return

    try:
        if input(f"Type {C_BOLD}yes{C_RESET} to proceed: ").strip().lower() != "yes":
            print("Aborted. Nothing changed.")
            return
    except (EOFError, KeyboardInterrupt):
        print("\nAborted. Nothing changed.")
        return

    before, _ = disk_free()
    elevated: list[str] = []
    print()

    for t in sel:
        try:
            if t.runner:
                print(f"  {C_GREEN}ok{C_RESET}  {t.label} - {t.runner()}")
                continue

            removed, skipped = 0, 0
            for p in t.paths:
                if not guard(p):
                    skipped += 1
                    continue
                try:
                    if p.is_dir() and not p.is_symlink():
                        shutil.rmtree(p)
                    else:
                        p.unlink()
                    removed += 1
                except PermissionError:
                    elevated.append(str(p))
                    skipped += 1
                except OSError:
                    skipped += 1

            tail = f" ({skipped} skipped)" if skipped else ""
            state = C_GREEN + "ok" + C_RESET if removed else C_YELLOW + "--" + C_RESET
            print(f"  {state}  {t.label}{tail}")
        except Exception as e:
            print(f"  {C_RED}!!{C_RESET}  {t.label}: {e}")

    time.sleep(2)
    after, _ = disk_free()

    print(f"\n{C_BOLD}Done.{C_RESET}")
    print(f"  free: {human(before)} -> {C_BOLD}{human(after)}{C_RESET}  "
          f"({C_GREEN}+{human(max(0, after - before))}{C_RESET})")
    if any(t.runner and t.key.startswith("rt_") for t in sel):
        print(f"  {C_DIM}Simulator runtime deletion runs in the background; "
              f"more space frees up shortly.{C_RESET}")
    if QUARANTINE_DIR.exists():
        print(f"  {C_CYAN}Quarantined files -> {QUARANTINE_DIR}{C_RESET}")
    if elevated:
        print(f"\n  {C_YELLOW}Needs elevated permission. Remove these yourself:{C_RESET}")
        for line in elevated_command(elevated):
            print("    " + line)


def elevated_command(paths: list[str]) -> list[str]:
    """Shell command, as lines, for paths the run could not delete itself.

    PowerShell's Remove-Item binds only one bare string positionally, so
    several quoted paths in a row fail with PositionalParameterNotFound.
    Pass them as an array instead, and use -LiteralPath so a path holding
    [ or ] is not read as a wildcard.
    """
    if not IS_WIN:
        return ["sudo rm -rf " + " ".join(f'"{p}"' for p in paths)]
    if len(paths) == 1:
        return [f'Remove-Item -Recurse -Force -LiteralPath "{paths[0]}"']
    return (["Remove-Item -Recurse -Force -LiteralPath @("]
            + [f'    "{p}"' for p in paths]
            + [")"])


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Interactive disk cleanup for developer machines.")
    ap.add_argument("--dry-run", action="store_true", help="show the plan, change nothing")
    ap.add_argument("--safe-only", action="store_true", help="only offer SAFE items")
    args = ap.parse_args()

    print(f"\n{C_BOLD}devclean{C_RESET} {C_DIM}({OS_NAME}){C_RESET}")
    targets = scan(args.safe_only)
    if not targets:
        print("Nothing worth cleaning.")
        return 0

    if not sys.stdin.isatty():
        for t in targets:
            print(f"{t.risk:<6} {human(t.size).rjust(9)}  {t.label}")
        return 0

    try:
        if choose(targets):
            execute(targets, args.dry_run)
        else:
            print("Cancelled. Nothing changed.")
    except KeyboardInterrupt:
        print("\nCancelled. Nothing changed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
